#cloud-config
datasource:
  Ec2:
    strict_id: false
ssh_pwauth: no
users:
  - name: ${ssh_user}
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    groups: sudo
    ssh_authorized_keys:
      - ${ssh_public_key}
package_update: true
packages:
  - python3
  - python3-apt
  - sudo
runcmd:
  - [sh, -c, "mkdir -p /opt/restobot && chown ${ssh_user}:${ssh_user} /opt/restobot"]
